# Set in Vercel for Production and Preview, then redeploy.
GALLERY_PASSWORD=replace-with-your-shared-access-password
GALLERY_ADMIN_PASSWORD=replace-with-a-different-private-admin-password
# PostgreSQL connection string, including the provider's TLS options.
# Use separate databases for Production and Preview.
GALLERY_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Local-only alternative (set automatically by the local entry point):
# GALLERY_SQLITE_PATH=/absolute/path/to/gallery-events.sqlite3
# Neon integration DATABASE_URL is also accepted automatically.
